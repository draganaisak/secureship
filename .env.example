# Backend (resource server - validates the admin access token)
AUTH0_DOMAIN=your-tenant.eu.auth0.com          # no https://
AUTH0_AUDIENCE=https://secureship-admin-api     # your API Identifier
AUTH0_ADMIN_SUBS=auth0|id                       # admin user id (token sub); comma-separate for more

# Frontend (React SPA - Auth0 login)
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://secureship-admin-api
